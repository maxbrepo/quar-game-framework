// QGF lifecycle transition model for QRVM.
// States: 0 CREATED, 1 INITIALIZED, 2 RUNNING, 3 STOPPED.
// Errors: 0 NONE, 1 INVALID_TRANSITION.
// Pure functions: the caller owns the state and decides when to commit it.

int qgf_state_created() {
    return 0;
}

int qgf_state_initialized() {
    return 1;
}

int qgf_state_running() {
    return 2;
}

int qgf_state_stopped() {
    return 3;
}

int qgf_error_none() {
    return 0;
}

int qgf_error_invalid_transition() {
    return 1;
}

bool qgf_can_initialize(int state) {
    return state == 0;
}

bool qgf_can_start(int state) {
    return state == 1;
}

bool qgf_can_stop(int state) {
    if (state == 1) {
        return true;
    }
    return state == 2;
}

bool qgf_is_active(int state) {
    return state == 2;
}

// A rejected transition preserves the current state.
int qgf_initialize_state(int state) {
    if (state == 0) {
        return 1;
    }
    return state;
}

int qgf_start_state(int state) {
    if (state == 1) {
        return 2;
    }
    return state;
}

int qgf_stop_state(int state) {
    if (state == 1) {
        return 3;
    }
    if (state == 2) {
        return 3;
    }
    return state;
}

// Compute error from the state BEFORE attempting the transition.
int qgf_initialize_error(int state) {
    if (state == 0) {
        return 0;
    }
    return 1;
}

int qgf_start_error(int state) {
    if (state == 1) {
        return 0;
    }
    return 1;
}

int qgf_stop_error(int state) {
    if (state == 1) {
        return 0;
    }
    if (state == 2) {
        return 0;
    }
    return 1;
}

// Configuration is caller-owned: no hidden mutable global state.
// A configuration is valid only when its numeric values are positive.
bool qgf_config_valid(int width, int height, int target_fps) {
    if (width > 0) {
        if (height > 0) {
            return target_fps > 0;
        }
    }
    return false;
}

// Configuration error codes: 0 NONE, 2 INVALID_CONFIG.
int qgf_config_error(int width, int height, int target_fps) {
    if (qgf_config_valid(width, height, target_fps)) {
        return 0;
    }
    return 2;
}

// Diagnostic queries are pure and never mutate the lifecycle state.
bool qgf_state_valid(int state) {
    if (state == 0) {
        return true;
    }
    if (state == 1) {
        return true;
    }
    if (state == 2) {
        return true;
    }
    return state == 3;
}

bool qgf_is_initialized(int state) {
    if (state == 1) {
        return true;
    }
    return state == 2;
}

bool qgf_is_stopped(int state) {
    return state == 3;
}

bool qgf_error_present(int error_code) {
    return error_code != 0;
}
