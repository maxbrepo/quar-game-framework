// QGF Chapter 17A: lightweight diagnostics primitives.
// Severity severitys: 0 trace, 1 info, 2 warning, 3 error.
bool debug_level_valid(int severity) {
    if (severity < 0) { return false; }
    return severity <= 3;
}
bool debug_should_log(int severity,int threshold,bool enabled) {
    if (enabled == false) { return false; }
    if (debug_level_valid(severity) == false) { return false; }
    if (debug_level_valid(threshold) == false) { return false; }
    return severity >= threshold;
}
int debug_error_code(bool condition,int error_code) {
    if (condition) { return 0; }
    return error_code;
}
int debug_count_next(int count,bool event_occurred) {
    if (count < 0) { return 0; }
    if (event_occurred) { return count+1; }
    return count;
}
bool debug_count_limit_reached(int count,int limit) {
    if (limit <= 0) { return false; }
    return count >= limit;
}
double debug_duration(double start,double end) {
    if (end < start) { return 0.0; }
    return end-start;
}
double debug_average(double total,int samples) {
    if (samples <= 0) { return 0.0; }
    return total/samples;
}
double debug_clamp_progress(double progress) {
    if (progress < 0.0) { return 0.0; }
    if (progress > 1.0) { return 1.0; }
    return progress;
}
bool debug_assert_range(double value,double minimum,double maximum) {
    if (maximum < minimum) { return false; }
    if (value < minimum) { return false; }
    return value <= maximum;
}
int debug_select_severity(int current,int incoming) {
    if (debug_level_valid(incoming) == false) { return current; }
    if (debug_level_valid(current) == false) { return incoming; }
    if (incoming > current) { return incoming; }
    return current;
}

// Chapter 17B: message filtering and compact logging policies.
// Categories are non-negative IDs; the caller owns the message text and output sink.
bool debug_category_valid(int category) {
    return category >= 0;
}
bool debug_message_allowed(int severity,int threshold,bool enabled,int category) {
    if (debug_category_valid(category) == false) { return false; }
    return debug_should_log(severity,threshold,enabled);
}
bool debug_category_matches(int category,int filter_category) {
    if (debug_category_valid(category) == false) { return false; }
    if (filter_category < 0) { return true; }
    return category == filter_category;
}
bool debug_log_allowed(int severity,int threshold,bool enabled,int category,int filter_category) {
    if (debug_message_allowed(severity,threshold,enabled,category) == false) { return false; }
    return debug_category_matches(category,filter_category);
}
int debug_log_count(int count,bool accepted) {
    return debug_count_next(count,accepted);
}
bool debug_log_capacity(int count,int maximum) {
    if (maximum <= 0) { return false; }
    if (count < 0) { return false; }
    return count < maximum;
}
bool debug_log_with_capacity(int severity,int threshold,bool enabled,int category,int filter_category,int count,int maximum) {
    if (debug_log_capacity(count,maximum) == false) { return false; }
    return debug_log_allowed(severity,threshold,enabled,category,filter_category);
}
int debug_warning_count(int count,int severity,bool accepted) {
    if (accepted == false) { return count; }
    if (severity < 2) { return count; }
    return debug_count_next(count,true);
}
int debug_error_count(int count,int severity,bool accepted) {
    if (accepted == false) { return count; }
    if (severity != 3) { return count; }
    return debug_count_next(count,true);
}
int debug_last_severity(int previous,int incoming,bool accepted) {
    if (accepted == false) { return previous; }
    if (debug_level_valid(incoming) == false) { return previous; }
    return incoming;
}

// Chapter 17C: scalar profiling and frame statistics.
// Timing values must be supplied by the caller; no system clock is accessed.
double debug_profile_elapsed(double start,double end) {
    return debug_duration(start,end);
}
double debug_profile_total(double total,double elapsed) {
    if (elapsed < 0.0) { return total; }
    return total+elapsed;
}
int debug_profile_samples(int count,bool recorded) {
    return debug_count_next(count,recorded);
}
double debug_profile_mean(double total,int samples) {
    return debug_average(total,samples);
}
double debug_profile_min(double previous,double sample,bool has_previous) {
    if (sample < 0.0) { return previous; }
    if (has_previous == false) { return sample; }
    if (sample < previous) { return sample; }
    return previous;
}
double debug_profile_max(double previous,double sample,bool has_previous) {
    if (sample < 0.0) { return previous; }
    if (has_previous == false) { return sample; }
    if (sample > previous) { return sample; }
    return previous;
}
double debug_frame_fps(double frame_seconds) {
    if (frame_seconds <= 0.0) { return 0.0; }
    return 1.0/frame_seconds;
}
bool debug_frame_slow(double frame_seconds,double budget_seconds) {
    if (frame_seconds < 0.0) { return false; }
    if (budget_seconds <= 0.0) { return false; }
    return frame_seconds > budget_seconds;
}
double debug_frame_budget_ratio(double frame_seconds,double budget_seconds) {
    if (frame_seconds < 0.0) { return 0.0; }
    if (budget_seconds <= 0.0) { return 0.0; }
    return frame_seconds/budget_seconds;
}
bool debug_profile_threshold(double elapsed,double threshold) {
    if (elapsed < 0.0) { return false; }
    if (threshold <= 0.0) { return false; }
    return elapsed >= threshold;
}

// Chapter 17D: combined diagnostic decisions for a single update.
bool debug_event_recordable(int severity,int threshold,bool enabled,int category,int filter_category,int count,int capacity) {
    return debug_log_with_capacity(severity,threshold,enabled,category,filter_category,count,capacity);
}
bool debug_frame_warning(double frame_seconds,double budget_seconds,int severity,int threshold,bool enabled) {
    if (debug_frame_slow(frame_seconds,budget_seconds) == false) { return false; }
    return debug_should_log(severity,threshold,enabled);
}
