// Chapter 15A: backend-independent game UI geometry and interaction.
// Coordinates are expressed in logical screen units.
bool ui_size_valid(double width,double height) {
    if (width <= 0.0) { return false; }
    return height > 0.0;
}
bool ui_visible(bool enabled,bool hidden) {
    if (enabled == false) { return false; }
    return hidden == false;
}
bool ui_point_inside(double px,double py,double x,double y,double width,double height) {
    if (ui_size_valid(width,height) == false) { return false; }
    if (px < x) { return false; }
    if (py < y) { return false; }
    if (px >= x+width) { return false; }
    return py < y+height;
}
bool ui_button_hover(bool visible,bool enabled,double px,double py,double x,double y,double width,double height) {
    if (visible == false) { return false; }
    if (enabled == false) { return false; }
    return ui_point_inside(px,py,x,y,width,height);
}
bool ui_button_pressed(bool visible,bool enabled,bool pointer_down,double px,double py,double x,double y,double width,double height) {
    if (pointer_down == false) { return false; }
    return ui_button_hover(visible,enabled,px,py,x,y,width,height);
}
double ui_center_x(double parent_x,double parent_width,double child_width) {
    return parent_x+(parent_width-child_width)/2.0;
}
double ui_center_y(double parent_y,double parent_height,double child_height) {
    return parent_y+(parent_height-child_height)/2.0;
}
double ui_clamp_progress(double progress) {
    if (progress < 0.0) { return 0.0; }
    if (progress > 1.0) { return 1.0; }
    return progress;
}
double ui_progress_width(double width,double progress) {
    if (width < 0.0) { return 0.0; }
    return width*ui_clamp_progress(progress);
}
bool ui_rect_overlap(double ax,double ay,double aw,double ah,double bx,double by,double bw,double bh) {
    if (ui_size_valid(aw,ah) == false) { return false; }
    if (ui_size_valid(bw,bh) == false) { return false; }
    if (ax+aw <= bx) { return false; }
    if (bx+bw <= ax) { return false; }
    if (ay+ah <= by) { return false; }
    return by+bh > ay;
}

// Chapter 15B: HUD and menu helpers. Values use logical UI units.
bool ui_hud_visible(bool hud_enabled,bool game_paused) {
    if (hud_enabled == false) { return false; }
    return game_paused == false;
}
bool ui_menu_visible(bool menu_open,bool ui_enabled) {
    if (ui_enabled == false) { return false; }
    return menu_open;
}
bool ui_menu_item_valid(int item,int count) {
    if (count <= 0) { return false; }
    if (item < 0) { return false; }
    return item < count;
}
int ui_menu_next(int current,int count) {
    if (count <= 0) { return 0; }
    if (ui_menu_item_valid(current,count) == false) { return 0; }
    if (current+1 >= count) { return 0; }
    return current+1;
}
int ui_menu_previous(int current,int count) {
    if (count <= 0) { return 0; }
    if (ui_menu_item_valid(current,count) == false) { return 0; }
    if (current <= 0) { return count-1; }
    return current-1;
}
bool ui_menu_activate(bool menu_open,bool enabled,int selected,int count) {
    if (menu_open == false) { return false; }
    if (enabled == false) { return false; }
    return ui_menu_item_valid(selected,count);
}
double ui_hud_ratio(double current,double maximum) {
    if (maximum <= 0.0) { return 0.0; }
    return ui_clamp_progress(current/maximum);
}
double ui_hud_bar_width(double width,double current,double maximum) {
    return ui_progress_width(width,ui_hud_ratio(current,maximum));
}
double ui_stack_y(double top,double item_height,double gap,int index) {
    if (index < 0) { return top; }
    return top+(item_height+gap)*index;
}
bool ui_button_active(bool visible,bool enabled,bool pointer_down,double px,double py,double x,double y,double width,double height) {
    return ui_button_pressed(visible,enabled,pointer_down,px,py,x,y,width,height);
}

// Chapter 15C: interaction state helpers (logic only, no rendering).
bool ui_pointer_just_pressed(bool pointer_down,bool previous_down) {
    if (pointer_down == false) { return false; }
    return previous_down == false;
}
bool ui_pointer_just_released(bool pointer_down,bool previous_down) {
    if (previous_down == false) { return false; }
    return pointer_down == false;
}
bool ui_button_clicked(bool visible,bool enabled,bool pointer_down,bool previous_down,double px,double py,double x,double y,double width,double height) {
    if (ui_pointer_just_pressed(pointer_down,previous_down) == false) { return false; }
    return ui_button_hover(visible,enabled,px,py,x,y,width,height);
}
bool ui_button_released_inside(bool visible,bool enabled,bool pointer_down,bool previous_down,double px,double py,double x,double y,double width,double height) {
    if (ui_pointer_just_released(pointer_down,previous_down) == false) { return false; }
    return ui_button_hover(visible,enabled,px,py,x,y,width,height);
}
bool ui_menu_selectable(bool menu_open,bool enabled,int index,int count) {
    return ui_menu_activate(menu_open,enabled,index,count);
}
int ui_menu_move(int current,int count,bool forward,bool enabled) {
    if (enabled == false) { return current; }
    if (forward) { return ui_menu_next(current,count); }
    return ui_menu_previous(current,count);
}
double ui_slider_ratio(double px,double x,double width) {
    if (width <= 0.0) { return 0.0; }
    return ui_clamp_progress((px-x)/width);
}
double ui_slider_value(double px,double x,double width,double minimum,double maximum) {
    if (maximum <= minimum) { return minimum; }
    return minimum+(maximum-minimum)*ui_slider_ratio(px,x,width);
}
bool ui_focus_valid(bool visible,bool enabled,int focused,int count) {
    if (visible == false) { return false; }
    if (enabled == false) { return false; }
    return ui_menu_item_valid(focused,count);
}

// Chapter 15D: combined UI state and layout checks.
bool ui_interactive(bool visible,bool enabled,bool menu_open) {
    if (visible == false) { return false; }
    if (enabled == false) { return false; }
    return menu_open;
}
bool ui_menu_pointer_click(bool menu_open,bool enabled,bool pointer_down,bool previous_down,double px,double py,double x,double y,double width,double height) {
    if (ui_interactive(true,enabled,menu_open) == false) { return false; }
    return ui_button_clicked(true,true,pointer_down,previous_down,px,py,x,y,width,height);
}
double ui_hud_safe_width(double width,double current,double maximum,bool visible) {
    if (visible == false) { return 0.0; }
    return ui_hud_bar_width(width,current,maximum);
}
int ui_menu_safe_move(int current,int count,bool forward,bool menu_open) {
    if (menu_open == false) { return current; }
    return ui_menu_move(current,count,forward,true);
}
double ui_slider_safe_value(double px,double x,double width,double minimum,double maximum,bool enabled) {
    if (enabled == false) { return minimum; }
    return ui_slider_value(px,x,width,minimum,maximum);
}
bool ui_focus_and_menu(bool visible,bool enabled,bool menu_open,int focused,int count) {
    if (menu_open == false) { return false; }
    return ui_focus_valid(visible,enabled,focused,count);
}
