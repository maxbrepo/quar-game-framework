// Chapter 12A: deterministic, SDL-independent elementary 2D physics.
// Positions use world units, velocity units per second, and time seconds.
bool physics_valid_dt(double dt) { return dt >= 0.0; }
bool physics_valid_mass(double mass) { return mass > 0.0; }
double physics_position(double position, double velocity, double dt) {
    if (physics_valid_dt(dt) == false) { return position; }
    return position + velocity * dt;
}
double physics_velocity(double velocity, double acceleration, double dt) {
    if (physics_valid_dt(dt) == false) { return velocity; }
    return velocity + acceleration * dt;
}
double physics_acceleration(double force, double mass) {
    if (physics_valid_mass(mass) == false) { return 0.0; }
    return force / mass;
}
double physics_displacement(double velocity, double acceleration, double dt) {
    if (physics_valid_dt(dt) == false) { return 0.0; }
    return velocity * dt + 0.5 * acceleration * dt * dt;
}
double physics_integrate_position(double position, double velocity, double acceleration, double dt) {
    return position + physics_displacement(velocity, acceleration, dt);
}
double physics_clamp_speed(double speed, double maximum) {
    if (maximum < 0.0) { return speed; }
    if (speed > maximum) { return maximum; }
    if (speed < -maximum) { return -maximum; }
    return speed;
}
double physics_apply_drag(double velocity, double factor, double dt) {
    if (physics_valid_dt(dt) == false) { return velocity; }
    if (factor < 0.0) { return velocity; }
    double multiplier = 1.0 - factor * dt;
    if (multiplier < 0.0) { multiplier = 0.0; }
    return velocity * multiplier;
}
double physics_gravity_velocity(double velocity_y, double gravity_y, double dt) {
    return physics_velocity(velocity_y, gravity_y, dt);
}

// Chapter 12B: elementary collision response against static geometry.
// Contact at the boundary counts as collision, consistent with collision2d.
bool physics_box_hits_static(double x,double y,double w,double h,double sx,double sy,double sw,double sh) {
    if (w < 0.0) { return false; }
    if (h < 0.0) { return false; }
    if (sw < 0.0) { return false; }
    if (sh < 0.0) { return false; }
    if (x > sx+sw) { return false; }
    if (sx > x+w) { return false; }
    if (y > sy+sh) { return false; }
    return sy <= y+h;
}
bool physics_circle_hits_static(double x,double y,double radius,double sx,double sy,double static_radius) {
    if (radius < 0.0) { return false; }
    if (static_radius < 0.0) { return false; }
    double dx=x-sx; double dy=y-sy; double sum=radius+static_radius;
    return dx*dx+dy*dy <= sum*sum;
}
// Axis-aligned motion: stop at a wall without crossing it when approaching from the left.
double physics_stop_at_right_wall(double x,double width,double vx,double dt,double wall_x) {
    if (width < 0.0) { return x; }
    if (physics_valid_dt(dt) == false) { return x; }
    double next=physics_position(x,vx,dt);
    if (vx > 0.0) {
        if (x+width <= wall_x) {
            if (next+width >= wall_x) { return wall_x-width; }
        }
    }
    return next;
}
double physics_stop_velocity_at_right_wall(double x,double width,double vx,double dt,double wall_x) {
    if (width < 0.0) { return vx; }
    if (physics_valid_dt(dt) == false) { return vx; }
    if (vx > 0.0) {
        if (x+width <= wall_x) {
            if (x+width+vx*dt >= wall_x) { return 0.0; }
        }
    }
    return vx;
}
// Restitution is clamped to [0,1]; positive speed rebounds as negative speed.
double physics_bounce_velocity(double velocity,double restitution) {
    if (restitution < 0.0) { restitution=0.0; }
    if (restitution > 1.0) { restitution=1.0; }
    return -velocity*restitution;
}
// Separate a moving box from a static box along one axis; ties favor X.
double physics_box_separate_x(double x,double y,double w,double h,double sx,double sy,double sw,double sh) {
    if (w <= 0.0) { return x; }
    if (h <= 0.0) { return x; }
    if (sw <= 0.0) { return x; }
    if (sh <= 0.0) { return x; }
    double left=x; if (sx > left) { left=sx; }
    double right=x+w; if (sx+sw < right) { right=sx+sw; }
    double top=y; if (sy > top) { top=sy; }
    double bottom=y+h; if (sy+sh < bottom) { bottom=sy+sh; }
    double px=right-left; double py=bottom-top;
    if (px <= 0.0) { return x; }
    if (py <= 0.0) { return x; }
    if (px > py) { return x; }
    if (x+w*0.5 <= sx+sw*0.5) { return x-px; }
    return x+px;
}
double physics_box_separate_y(double x,double y,double w,double h,double sx,double sy,double sw,double sh) {
    if (w <= 0.0) { return y; }
    if (h <= 0.0) { return y; }
    if (sw <= 0.0) { return y; }
    if (sh <= 0.0) { return y; }
    double left=x; if (sx > left) { left=sx; }
    double right=x+w; if (sx+sw < right) { right=sx+sw; }
    double top=y; if (sy > top) { top=sy; }
    double bottom=y+h; if (sy+sh < bottom) { bottom=sy+sh; }
    double px=right-left; double py=bottom-top;
    if (px <= 0.0) { return y; }
    if (py <= 0.0) { return y; }
    if (py >= px) { return y; }
    if (y+h*0.5 <= sy+sh*0.5) { return y-py; }
    return y+py;
}

// Chapter 12C: discrete-time motion and ground response.
// These scalar helpers intentionally avoid introducing a general rigid-body solver.
double physics_step_velocity(double velocity,double acceleration,double dt) {
    return physics_velocity(velocity,acceleration,dt);
}
double physics_step_position(double position,double updated_velocity,double dt) {
    return physics_position(position,updated_velocity,dt);
}
// World Y grows downward. A positive gravity value pulls toward the ground.
double physics_ground_position(double next_y,double height,double ground_y) {
    if (height < 0.0) { return next_y; }
    if (next_y+height > ground_y) { return ground_y-height; }
    return next_y;
}
bool physics_ground_contact(double y,double height,double ground_y) {
    if (height < 0.0) { return false; }
    return y+height >= ground_y;
}
double physics_ground_velocity(double next_y,double height,double velocity_y,double ground_y) {
    if (velocity_y > 0.0) {
        if (physics_ground_contact(next_y,height,ground_y)) { return 0.0; }
    }
    return velocity_y;
}
double physics_ground_bounce(double next_y,double height,double velocity_y,double ground_y,double restitution) {
    if (velocity_y > 0.0) {
        if (physics_ground_contact(next_y,height,ground_y)) {
            return physics_bounce_velocity(velocity_y,restitution);
        }
    }
    return velocity_y;
}
// Integrate an axis over two fixed steps with semi-implicit Euler.
double physics_two_step_velocity(double velocity,double acceleration,double dt) {
    double v1=physics_step_velocity(velocity,acceleration,dt);
    return physics_step_velocity(v1,acceleration,dt);
}
double physics_two_step_position(double position,double velocity,double acceleration,double dt) {
    double v1=physics_step_velocity(velocity,acceleration,dt);
    double p1=physics_step_position(position,v1,dt);
    double v2=physics_step_velocity(v1,acceleration,dt);
    return physics_step_position(p1,v2,dt);
}

// Chapter 12D: bounded fixed-step simulation helpers.
// Returns the final vertical position after three semi-implicit Euler steps.
double physics_three_step_position(double position,double velocity,double acceleration,double dt) {
    if (physics_valid_dt(dt) == false) { return position; }
    double v1=physics_step_velocity(velocity,acceleration,dt);
    double p1=physics_step_position(position,v1,dt);
    double v2=physics_step_velocity(v1,acceleration,dt);
    double p2=physics_step_position(p1,v2,dt);
    double v3=physics_step_velocity(v2,acceleration,dt);
    return physics_step_position(p2,v3,dt);
}
// Returns the final velocity after three fixed steps.
double physics_three_step_velocity(double velocity,double acceleration,double dt) {
    if (physics_valid_dt(dt) == false) { return velocity; }
    double v1=physics_step_velocity(velocity,acceleration,dt);
    double v2=physics_step_velocity(v1,acceleration,dt);
    return physics_step_velocity(v2,acceleration,dt);
}
// Returns a clamped position after one integration step and ground contact.
double physics_step_ground_position(double position,double height,double velocity,double acceleration,double dt,double ground_y) {
    if (physics_valid_dt(dt) == false) { return position; }
    double next_velocity=physics_step_velocity(velocity,acceleration,dt);
    double next_position=physics_step_position(position,next_velocity,dt);
    return physics_ground_position(next_position,height,ground_y);
}
// Returns zero vertical velocity on ground contact after one integration step.
double physics_step_ground_velocity(double position,double height,double velocity,double acceleration,double dt,double ground_y) {
    if (physics_valid_dt(dt) == false) { return velocity; }
    double next_velocity=physics_step_velocity(velocity,acceleration,dt);
    double next_position=physics_step_position(position,next_velocity,dt);
    return physics_ground_velocity(next_position,height,next_velocity,ground_y);
}
// Returns a rebound velocity if the next position contacts the ground.
double physics_step_ground_bounce(double position,double height,double velocity,double acceleration,double dt,double ground_y,double restitution) {
    if (physics_valid_dt(dt) == false) { return velocity; }
    double next_velocity=physics_step_velocity(velocity,acceleration,dt);
    double next_position=physics_step_position(position,next_velocity,dt);
    return physics_ground_bounce(next_position,height,next_velocity,ground_y,restitution);
}
