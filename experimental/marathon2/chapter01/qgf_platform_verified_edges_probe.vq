int none_state = qgf_backend_created();
print(qgf_backend_can_prepare_verified(none_state, qgf_backend_none(), false));
none_state = qgf_backend_prepare_verified(none_state, qgf_backend_none(), false);
print(none_state);
print(qgf_backend_can_prepare_verified(none_state, qgf_backend_none(), true));
print(qgf_backend_can_prepare_verified(qgf_backend_created(), qgf_backend_sdl3(), false));
print(qgf_backend_prepare_verified(qgf_backend_created(), qgf_backend_sdl3(), false));
print(qgf_backend_can_prepare_verified(qgf_backend_created(), 99, true));
print(qgf_backend_prepare_verified(qgf_backend_created(), 99, true));
print(qgf_backend_can_prepare_verified(qgf_backend_created(), qgf_backend_sdl3(), true));
int state = qgf_backend_prepare_verified(qgf_backend_created(), qgf_backend_sdl3(), true);
print(state);
print(qgf_backend_can_prepare_verified(state, qgf_backend_sdl3(), true));
state = qgf_backend_start(state);
print(state);
print(qgf_backend_can_prepare_verified(state, qgf_backend_sdl3(), true));
state = qgf_backend_stop(state);
print(state);
print(qgf_backend_can_prepare_verified(state, qgf_backend_sdl3(), true));
state = qgf_backend_reset(state);
print(state);
print(qgf_backend_can_prepare_verified(state, qgf_backend_sdl3(), false));
