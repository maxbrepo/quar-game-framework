extern "C" bool SDL_Init(u32 flags);
extern "C" u32 SDL_WasInit(u32 flags);
extern "C" void SDL_Quit();
u32 video_flags = 32;
int app_state = qgf_state_created();
int backend_state = 0;
int init_action = qgf_lifecycle_contract_action(backend_state, true);
print(init_action);
bool init_ok = SDL_Init(video_flags);
print(init_ok);
backend_state = qgf_lifecycle_contract_apply(backend_state, init_action, init_ok);
print(backend_state);
print(qgf_lifecycle_contract_verify(0, init_action, backend_state, init_ok));
if (backend_state == 1) {
    if (qgf_can_initialize(app_state)) {
        app_state = qgf_initialize_state(app_state);
    }
}
print(app_state);
print(qgf_can_start(app_state));
if (backend_state == 1) {
    if (qgf_can_start(app_state)) {
        app_state = qgf_start_state(app_state);
    }
}
print(app_state);
u32 video_active = SDL_WasInit(video_flags);
print(video_active);
if (backend_state == 1) {
    int quit_action = qgf_lifecycle_contract_action(backend_state, false);
    print(quit_action);
    if (qgf_can_stop(app_state)) {
        SDL_Quit();
        backend_state = qgf_lifecycle_contract_apply(backend_state, quit_action, true);
        app_state = qgf_stop_state(app_state);
    }
    print(app_state);
    print(backend_state);
    u32 after = SDL_WasInit(video_flags);
    print(after);
}
if (backend_state == 2) {
    int denied = qgf_lifecycle_contract_action(backend_state, true);
    print(denied);
    int reset_action = qgf_lifecycle_contract_action(backend_state, false);
    print(reset_action);
    backend_state = qgf_lifecycle_contract_apply(backend_state, reset_action, true);
    print(backend_state);
    print(app_state);
}
