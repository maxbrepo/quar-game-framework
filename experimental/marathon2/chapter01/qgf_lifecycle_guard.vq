// Marathon 2: pure guards for native lifecycle orchestration.
// No SDL3 calls. States: 0 stopped, 1 active, 2 error.
// Actions: 0 idle, 1 initialize, 2 shutdown, 3 reset error.
// Native calls must be performed only after the action has been approved.
bool qgf_lifecycle_action_allowed(int state, int action) {
    if (state < 0) { return false; }
    if (state > 2) { return false; }
    if (action == 0) { return true; }
    if (action == 1) { return state == 0; }
    if (action == 2) { return state == 1; }
    if (action == 3) { return state == 2; }
    return false;
}

// Returns the expected state after an approved action.
// The init outcome is supplied by the native caller; no FFI is performed here.
int qgf_lifecycle_guarded_result(int state, int action, bool native_success) {
    if (qgf_lifecycle_action_allowed(state, action) == false) { return state; }
    if (action == 1) {
        if (native_success) { return 1; }
        return 2;
    }
    if (action == 2) { return 0; }
    if (action == 3) { return 0; }
    return state;
}

// A failed native initialization enters error state and must be reset explicitly.
bool qgf_lifecycle_retry_requires_reset(int state) {
    return state == 2;
}
