extern "C" bool SDL_Init(u32 flags);
extern "C" u32 SDL_WasInit(u32 flags);
extern "C" void SDL_Quit();
u32 video_flags = 32;
int app_state = qgf_state_created();
int backend_state = 0;
print(qgf_config_valid(0, 480, 60));
print(qgf_config_error(0, 480, 60));
print(qgf_config_valid(640, -1, 60));
print(qgf_config_error(640, -1, 60));
print(qgf_config_valid(640, 480, 0));
print(qgf_config_error(640, 480, 0));
print(app_state);
print(backend_state);
u32 before = SDL_WasInit(video_flags);
print(before);
bool valid = qgf_config_valid(640, 480, 60);
print(valid);
if (valid) {
    if (qgf_can_initialize(app_state)) {
        int action = qgf_lifecycle_contract_action(backend_state, true);
        print(action);
        if (action == 1) {
            bool ok = SDL_Init(video_flags);
            print(ok);
            backend_state = qgf_lifecycle_contract_apply(backend_state, action, ok);
            if (backend_state == 1) {
                app_state = qgf_initialize_state(app_state);
                app_state = qgf_start_state(app_state);
            }
        }
    }
}
print(app_state);
print(backend_state);
u32 during = SDL_WasInit(video_flags);
print(during);
int quit_action = qgf_lifecycle_contract_action(backend_state, false);
print(quit_action);
if (quit_action == 2) {
    if (qgf_can_stop(app_state)) {
        SDL_Quit();
        backend_state = qgf_lifecycle_contract_apply(backend_state, quit_action, true);
        app_state = qgf_stop_state(app_state);
    }
}
print(app_state);
print(backend_state);
u32 after = SDL_WasInit(video_flags);
print(after);
