// Experimental QGF lifecycle state policy. No SDL calls or SDK dependencies.
// 0 = stopped, 1 = active, 2 = error.
// Pure transitions: the caller performs native operations separately.
int qgf_lifecycle_after_init(bool init_ok) {
    if (init_ok) { return 1; }
    return 2;
}

bool qgf_lifecycle_can_init(int state) {
    return state == 0;
}

bool qgf_lifecycle_needs_shutdown(int state) {
    return state == 1;
}

int qgf_lifecycle_after_shutdown(int state) {
    if (state == 1) { return 0; }
    return state;
}

bool qgf_lifecycle_can_reset_error(int state) {
    return state == 2;
}

int qgf_lifecycle_after_error_reset(int state) {
    if (state == 2) { return 0; }
    return state;
}

bool qgf_lifecycle_can_restart(int state) {
    return state == 0;
}
