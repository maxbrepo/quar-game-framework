extern "C" bool SDL_Init(u32 flags);
extern "C" u32 SDL_WasInit(u32 flags);
extern "C" void SDL_Quit();
int none_state = qgf_backend_created();
none_state = qgf_backend_prepare_verified(none_state, qgf_backend_none(), false);
print(none_state);
int denied = qgf_backend_prepare_verified(qgf_backend_created(), qgf_backend_sdl3(), false);
print(denied);
print(qgf_backend_can_prepare_verified(qgf_backend_ready(), qgf_backend_sdl3(), true));
print(qgf_backend_available(qgf_backend_sdl3()));
u32 flags = 32;
bool native_ok = SDL_Init(flags);
print(native_ok);
int state = qgf_backend_created();
state = qgf_backend_prepare_verified(state, qgf_backend_sdl3(), native_ok);
print(state);
print(qgf_backend_can_start(state));
state = qgf_backend_start(state);
print(state);
u32 active = SDL_WasInit(flags);
print(active);
print(qgf_backend_can_prepare_verified(state, qgf_backend_sdl3(), true));
if (native_ok) {
    SDL_Quit();
    state = qgf_backend_stop(state);
}
print(state);
u32 after = SDL_WasInit(flags);
print(after);
state = qgf_backend_reset(state);
print(state);
print(qgf_backend_available(qgf_backend_sdl3()));
