// Experimental sequence orchestration. No native SDL3 calls.
// Import/load qgf_lifecycle_transition.vq before using these helpers.
// State: 0 stopped, 1 active, 2 error.
// Action: 0 none, 1 call native init, 2 call native quit, 3 reset error.
int qgf_lifecycle_next_action(int state, bool want_running) {
    if (qgf_lifecycle_state_valid(state) == false) { return 0; }
    if (want_running) {
        if (qgf_lifecycle_init_requested(state)) { return 1; }
        return 0;
    }
    if (qgf_lifecycle_quit_requested(state)) { return 2; }
    if (state == 2) { return 3; }
    return 0;
}

int qgf_lifecycle_apply_init(int state, bool native_success) {
    return qgf_lifecycle_init_result(state, native_success);
}

int qgf_lifecycle_apply_quit(int state) {
    return qgf_lifecycle_quit_result(state);
}

int qgf_lifecycle_apply_reset(int state) {
    return qgf_lifecycle_reset_result(state);
}

bool qgf_lifecycle_sequence_consistent(int before, int action, int after, bool native_success) {
    if (qgf_lifecycle_state_valid(before) == false) { return false; }
    if (qgf_lifecycle_state_valid(after) == false) { return false; }
    if (qgf_lifecycle_action_allowed(before, action) == false) { return false; }
    if (action == 0) { return after == before; }
    if (action == 1) {
        return qgf_lifecycle_native_result_consistent(before, after, true, native_success);
    }
    if (action == 2) { return after == qgf_lifecycle_quit_result(before); }
    if (action == 3) { return after == qgf_lifecycle_reset_result(before); }
    return false;
}
