extern "C" u64 SDL_GetTicks();
extern "C" u64 SDL_GetPerformanceCounter();
extern "C" u64 SDL_GetPerformanceFrequency();
extern "C" i32 SDL_GetNumVideoDrivers();
u64 ticks_before = SDL_GetTicks();
u64 counter_before = SDL_GetPerformanceCounter();
u64 frequency = SDL_GetPerformanceFrequency();
i32 drivers = SDL_GetNumVideoDrivers();
u64 counter_after = SDL_GetPerformanceCounter();
u64 ticks_after = SDL_GetTicks();
print(ticks_before);
print(counter_before);
print(frequency);
print(drivers);
print(counter_after);
print(ticks_after);
