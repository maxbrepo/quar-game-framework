// EXPERIMENTAL / BLOCKED: source-level SDL3 FFI has not been validated.
// SDL3 ABI declaration proposal; SDK example 24_14 targets SDL2, not SDL3.
// This file is intentionally excluded from the Main Runner.
// SDL3 SDL_Init returns C bool; Visual Quar bool ABI mapping needs validation.
extern "C" bool SDL_Init(u32 flags);
extern "C" void SDL_Quit();

// SDL_INIT_VIDEO = 0x00000020 (32).
bool qgf_native_initialize_video() {
    return SDL_Init(32);
}

void qgf_native_shutdown() {
    SDL_Quit();
}

// SDL_GetError is deliberately omitted: cstring return is not yet supported
// by the inspected SDK NativeSignature adapter.
// SDL_Init failure handling and lifecycle state transitions are BLOCKED
// until the exact frontend and QRVM native call contract is validated.
