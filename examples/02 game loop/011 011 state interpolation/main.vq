// Only fixed updates change simulation state; rendering interpolates it.
int position = 0;
int previous_position = 0;
int remainder = 0;
int frame = 0;
while (frame < 3) {
    int delta_ms = 0;
    if (frame == 0) { delta_ms = 25; }
    if (frame == 1) { delta_ms = 10; }
    if (frame == 2) { delta_ms = 15; }
    int due = qgf_frame_fixed_steps(remainder, delta_ms, 20, 3);
    remainder = qgf_frame_remaining_ms(remainder, delta_ms, 20, 3);
    int completed = 0;
    while (completed < due) {
        previous_position = position;
        position = position + 10;
        completed = completed + 1;
    }
    double alpha = qgf_render_alpha(remainder, 20);
    double visible = qgf_render_interpolate(previous_position * 1.0, position * 1.0, alpha);
    print(due);
    print(position);
    print(visible);
    frame = frame + 1;
}
