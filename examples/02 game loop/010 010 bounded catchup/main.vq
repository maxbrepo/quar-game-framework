// A step cap defers excess simulation time without discarding it.
int remainder = 0;
int total_steps = 0;
int frame = 0;
while (frame < 3) {
    int delta_ms = 0;
    if (frame == 0) { delta_ms = 95; }
    int due = qgf_frame_fixed_steps(remainder, delta_ms, 20, 2);
    remainder = qgf_frame_remaining_ms(remainder, delta_ms, 20, 2);
    total_steps = total_steps + due;
    print(due);
    print(remainder);
    frame = frame + 1;
}
print(total_steps);
print(qgf_render_alpha(remainder, 20));
