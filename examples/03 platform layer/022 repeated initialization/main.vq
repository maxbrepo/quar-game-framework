// QGF Chapter 3B: 022 repeated initialization
int state = qgf_backend_created();
state = qgf_backend_prepare(state, qgf_backend_none());
print(state);
print(qgf_backend_prepare_error(state, qgf_backend_none()));
state = qgf_backend_prepare(state, qgf_backend_none());
print(state);
state = qgf_backend_start(state);
print(state);
print(qgf_backend_start_error(state));
