extern "C" bool SDL_Init(u32 flags);
extern "C" opaque SDL_CreateWindow(cstring title, i32 width, i32 height, u64 flags);
extern "C" opaque SDL_CreateRenderer(opaque window, cstring name);
extern "C" bool SDL_SetRenderDrawColorFloat(opaque renderer, f32 red, f32 green, f32 blue, f32 alpha);
extern "C" bool SDL_RenderClear(opaque renderer);
extern "C" bool SDL_RenderPoint(opaque renderer, f32 x, f32 y);
extern "C" bool SDL_RenderLine(opaque renderer, f32 x1, f32 y1, f32 x2, f32 y2);
extern "C" void SDL_RenderPresent(opaque renderer);
extern "C" void SDL_PumpEvents();
extern "C" bool SDL_HasEvent(u32 event_type);
extern "C" void SDL_Delay(u32 milliseconds);
extern "C" void SDL_DestroyRenderer(opaque renderer);
extern "C" void SDL_DestroyWindow(opaque window);
extern "C" void SDL_Quit();

bool batch_mode = false;
u32 video_flags = 32;
u64 window_flags = 0;
u32 quit_event = 256;
u32 key_event = 768;
u32 delay_ms = 16;
f32 zero = 0.0;
f32 one = 1.0;
f32 dark_r = 0.08;
f32 dark_g = 0.11;
f32 dark_b = 0.18;
f32 yellow_r = 1.0;
f32 yellow_g = 0.75;
f32 yellow_b = 0.2;
f32 green_r = 0.2;
f32 green_g = 0.9;
f32 green_b = 0.5;
f32 x1 = 70.0;
f32 y1 = 100.0;
f32 x2 = 560.0;
f32 y2 = 380.0;
f32 center_x = 320.0;
f32 motion = 0.0;
f32 speed = 2.0;
f32 limit = 160.0;
bool moving_right = true;
f32 center_y = 240.0;
f32 vertical_motion = 0.0;
f32 vertical_speed = 3.0;
f32 vertical_limit = 120.0;
bool moving_down = true;
bool init_result = SDL_Init(video_flags);
window = SDL_CreateWindow("QGF - Bouncing Cross (D003)", 640, 480, window_flags);
renderer = SDL_CreateRenderer(window, "software");
int frame_count = 0;
bool running = true;
while (running) {
    if (moving_right) {
        motion = motion + speed;
        if (motion >= limit) { moving_right = false; }
    } else {
        motion = motion - speed;
        if (motion <= zero) { moving_right = true; }
    }
    if (moving_down) {
        vertical_motion = vertical_motion + vertical_speed;
        if (vertical_motion >= vertical_limit) { moving_down = false; }
    } else {
        vertical_motion = vertical_motion - vertical_speed;
        if (vertical_motion <= zero) { moving_down = true; }
    }
    SDL_PumpEvents();
    if (SDL_HasEvent(quit_event)) { running = false; }
    if (SDL_HasEvent(key_event)) { running = false; }
    SDL_SetRenderDrawColorFloat(renderer, dark_r, dark_g, dark_b, one);
    SDL_RenderClear(renderer);
    SDL_SetRenderDrawColorFloat(renderer, yellow_r, yellow_g, yellow_b, one);
    SDL_RenderLine(renderer, x1 + motion, y1 + vertical_motion, x2 - motion, y2 - vertical_motion);
    SDL_RenderLine(renderer, x1 + motion, y2 - vertical_motion, x2 - motion, y1 + vertical_motion);
    SDL_SetRenderDrawColorFloat(renderer, green_r, green_g, green_b, one);
    SDL_RenderPoint(renderer, center_x + motion, center_y + vertical_motion);
    SDL_RenderPresent(renderer);
    SDL_Delay(delay_ms);
    frame_count = frame_count + 1;
    if (batch_mode) { if (frame_count >= 60) { running = false; } }
}
SDL_DestroyRenderer(renderer);
SDL_DestroyWindow(window);
SDL_Quit();
print("QGF_DEMO_OK");
