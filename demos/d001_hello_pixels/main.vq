extern "C" u32 SDL_Init(u32 flags);
extern "C" opaque SDL_CreateWindow(cstring title, i32 width, i32 height, u32 flags);
extern "C" opaque SDL_CreateRenderer(opaque window, cstring name);
extern "C" u32 SDL_SetRenderDrawColorFloat(opaque renderer, f32 red, f32 green, f32 blue, f32 alpha);
extern "C" u32 SDL_RenderClear(opaque renderer);
extern "C" u32 SDL_RenderPoint(opaque renderer, f32 x, f32 y);
extern "C" u32 SDL_RenderLine(opaque renderer, f32 x1, f32 y1, f32 x2, f32 y2);
extern "C" u32 SDL_RenderPresent(opaque renderer);
extern "C" void SDL_PumpEvents();
extern "C" u32 SDL_HasEvent(u32 event_type);
extern "C" void SDL_Delay(u32 milliseconds);
extern "C" void SDL_DestroyRenderer(opaque renderer);
extern "C" void SDL_DestroyWindow(opaque window);
extern "C" void SDL_Quit();

bool batch_mode = false;
u32 video_flags = 32;
u32 window_flags = 0;
u32 quit_event = 256;
u32 key_event = 768;
u32 delay_ms = 16;
f32 zero = 0.0;
f32 one = 1.0;
f32 dark_r = 0.08;
f32 dark_g = 0.11;
f32 dark_b = 0.18;
f32 yellow_r = 1.0;
f32 yellow_g = 0.75;
f32 yellow_b = 0.2;
f32 green_r = 0.2;
f32 green_g = 0.9;
f32 green_b = 0.5;
f32 x1 = 70.0;
f32 y1 = 100.0;
f32 x2 = 560.0;
f32 y2 = 380.0;
f32 center_x = 320.0;
f32 center_y = 240.0;
u32 init_result = SDL_Init(video_flags);
window = SDL_CreateWindow("QGF - Hello Pixels (D001)", 640, 480, window_flags);
renderer = SDL_CreateRenderer(window, "software");
int frame_count = 0;
bool running = true;
while (running) {
    SDL_PumpEvents();
    if (SDL_HasEvent(quit_event) != 0) { running = false; }
    if (SDL_HasEvent(key_event) != 0) { running = false; }
    SDL_SetRenderDrawColorFloat(renderer, dark_r, dark_g, dark_b, one);
    SDL_RenderClear(renderer);
    SDL_SetRenderDrawColorFloat(renderer, yellow_r, yellow_g, yellow_b, one);
    SDL_RenderLine(renderer, x1, y1, x2, y2);
    SDL_SetRenderDrawColorFloat(renderer, green_r, green_g, green_b, one);
    SDL_RenderPoint(renderer, center_x, center_y);
    SDL_RenderPresent(renderer);
    SDL_Delay(delay_ms);
    frame_count = frame_count + 1;
    if (batch_mode) { if (frame_count >= 60) { running = false; } }
}
SDL_DestroyRenderer(renderer);
SDL_DestroyWindow(window);
SDL_Quit();
print("QGF_DEMO_OK");
